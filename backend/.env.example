# Copy to .env for local work. On Railway, set these in the service's Variables tab instead.
# Every value below is FAKE. Never commit a real .env.

# --- Django core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# Comma-separated host names (no https://, no slash)
ALLOWED_HOSTS=your-backend.up.railway.app
# Full origins (with https://) of the web app that calls the API
CORS_ALLOWED_ORIGINS=https://your-frontend.up.railway.app
# Full origins allowed to submit forms / the Django admin login
CSRF_TRUSTED_ORIGINS=https://your-backend.up.railway.app,https://your-frontend.up.railway.app
# Used for links in emails (refill reminder reorder link)
FRONTEND_URL=https://your-frontend.up.railway.app

# --- Database ---
# Local example. On Railway use a reference: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://aquaflow:password@localhost:5432/aquaflow

# --- Routing (optional) ---
# Leave empty for straight-line estimates with no network calls
ORS_API_KEY=
ORS_PROFILE=driving-car
ORS_TIMEOUT_S=8

# --- Railway ---
# PORT is set by Railway automatically; do not add it yourself.

# --- bootstrap_production (first run on an EMPTY database) ---
# Any role whose EMAIL and PASSWORD are both set is created; others are skipped.
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_PASSWORD=ChangeMe-Owner-123
BOOTSTRAP_DISPATCHER_EMAIL=dispatcher@example.com
BOOTSTRAP_DISPATCHER_PASSWORD=ChangeMe-Dispatch-123
BOOTSTRAP_RIDER_EMAIL=rider@example.com
BOOTSTRAP_RIDER_PASSWORD=ChangeMe-Rider-123
BOOTSTRAP_CUSTOMER_EMAIL=customer@example.com
BOOTSTRAP_CUSTOMER_PASSWORD=ChangeMe-Customer-123
# Optional station / area / product / vehicle details (defaults are around Calapan)
BOOTSTRAP_STATION_NAME=AquaFlow Station
BOOTSTRAP_STATION_LAT=13.4108
BOOTSTRAP_STATION_LNG=121.1792
BOOTSTRAP_AREA_NAME=Calapan City
BOOTSTRAP_AREA_RADIUS_M=8000
BOOTSTRAP_PRODUCT_NAME=5-gallon refill
BOOTSTRAP_PRODUCT_PRICE=30
BOOTSTRAP_VEHICLE_NAME=Tricycle 1
BOOTSTRAP_VEHICLE_PLATE=AQF-001
BOOTSTRAP_VEHICLE_CAPACITY=20
